#!/bin/sh
# Force the root password to 'root'
echo "root:root" | chpasswd

# Ensure SSH config allows password and root login
sed -i 's/^#PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config 2>/dev/null
sed -i 's/^#PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config 2>/dev/null

# Ensure dropbear/SSH keys are placed properly just in case
mkdir -p /etc/dropbear /root/.ssh
cp /root/.ssh/authorized_keys /etc/dropbear/authorized_keys 2>/dev/null
chmod 600 /etc/dropbear/authorized_keys /root/.ssh/authorized_keys 2>/dev/null

exit 0
